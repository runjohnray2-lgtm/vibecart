# Shared VibeCart runtime
DATABASE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# VibeCart App Factory all-app subscription
APP_FACTORY_STRIPE_PRICE_ID=
VIBECART_APP_FACTORY_URL=https://vibecart.vercel.app
# Optional explicit Neon Auth settings. Production defaults are defined in lib/auth/server.ts.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Durable VibeCart Cloud bridge (server-side secrets)
VIBECART_CLOUD_INGEST_URL=https://your-deployment.example/api/cloud/ingest/he-said-nothing
VIBECART_CLOUD_INGEST_KEY=
VIBECART_ORDER_PERMALINK_TEMPLATE=https://hesaidnothing.com/he-said-nothing/admin/orders/{orderId}

# He Said Nothing controlled launch gate
HSN_CHECKOUT_ENABLED=false
HSN_CHECKOUT_MODE=test
HSN_SITE_URL=https://hesaidnothing.com
HSN_SHIPPING_RATE_CENTS=
HSN_PREMIUM_PACKAGING_CENTS=
HSN_ADMIN_PASSWORD=
HSN_ADMIN_SESSION_SECRET=
HSN_CLOUD_INTEGRATION_ID=he-said-nothing
HSN_SUPPORT_EMAIL=
HSN_RETURN_POLICY=
HSN_PROCESSING_TIME=

# Enable only after the merchant's Stripe Tax registrations/settings are ready.
VIBECART_AUTOMATIC_TAX_ENABLED=false
